# =============================================================================
# REQUIRED CONFIGURATION
# =============================================================================
# These variables are essential for the bot to function

# Discord Bot Token (REQUIRED)
TOKEN=<YOUR DISCORD BOT TOKEN>

# Discord Server ID (REQUIRED)
GUILD_ID=<YOUR DISCORD SERVER ID>

# Database Configuration (REQUIRED)
POSTGRES_USER=<USER NAME>
POSTGRES_PASSWORD=<YOUR PASSWORD>
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=bibi-db
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?sslmode=require
# The port is a variable because managed providers rarely serve 5432 - Aiven
# assigns a high port per service, and hardcoding 5432 silently connects to
# nothing.
#
# Only put options postgres.js actually knows in the query string. Anything it
# does not recognise is forwarded to the server as a startup parameter, so a
# provider-specific flag borrowed from another host - Neon's
# `channel_binding=require` is the one to watch - makes the server reject the
# connection outright with "unrecognized configuration parameter".

# =============================================================================
# OPTIONAL FEATURES
# =============================================================================
# These variables enable additional bot features when configured

# GIF Features (Optional)
KLIPY_API_KEY=  # Get from https://partner.klipy.com/api-keys

# AI Features (Optional)
GOOGLE_GENERATIVE_AI_API_KEY=  # Get from Google AI Studio
AI_SUMMARY_WINDOW=50  # Messages kept verbatim before older history is compacted into a summary (0 = disable)

# Role System (Optional)
# Use exact role names (comma separated) that exist in your Discord server
STAFF_ROLES=          # e.g. Admin,Owner,Moderator,Techlead
HELPER_ROLES=         # e.g. Helper,Senior Helper,Expert Helper
STATUS_ROLES=         # e.g. Verified,VoiceOnly,Jail
MEMBER_ROLES=         # e.g. Member,Contributor,Regular
LEVEL_ROLES=          # e.g. Script Kiddie!,Copy Paster!,Vibe Coder!,Intern!,Junior Dev!,Mid Dev!,Senior Dev!,Lead Dev!,Tech Lead!

# Channel Configuration (Optional)
# Use exact channel names (comma separated) that exist in your Discord server
GENERAL_CHANNELS=     # e.g. general,chat,discussion
BOT_CHANNELS=         # e.g. bot-commands,bot-spam
VERIFY_CHANNELS=      # e.g. verify,welcome
VOICE_EVENT_CHANNELS= # e.g. voice-logs
JOIN_EVENT_CHANNELS=  # e.g. join-leave-logs,member-logs
TEMPLATE_VALIDATION_CHANNELS= # e.g. community-updates
MEMBERS_COUNT_CHANNELS= # e.g. member-count,total-members

# Bot Behavior (Optional)
IS_CONSTRAINED_TO_BOT_CHANNEL=false    # true = restrict commands to bot channels only
SHOULD_LOG_VOICE_EVENTS=false          # true = log voice channel join/leave events
SHOULD_COUNT_MEMBERS=false             # true = auto-update member count channels
SHOULD_USER_LEVEL_UP=true              # false = disable user leveling system

# Admin API (Optional)
ADMIN_API_KEY=  # Secret key for admin API endpoints (generate with: openssl rand -hex 32)

# Hosting panel (Optional) - lets administrators run /restart from Discord.
# Expects a Pterodactyl-style client API: a key from the panel's account API
# page, and the server's short ID from its URL. Leave empty to disable.
PANEL_URL=        # e.g. https://panel.example.com (no trailing path)
PANEL_API_KEY=    # client API key from the panel
PANEL_SERVER_ID=  # e.g. 1a2b3c4d

# OG privileges (Optional)
SPAM_EXEMPT_ROLES=  # e.g. OG,Admin,Moderator

# Spam Exempt Channels (Optional)
SPAM_EXEMPT_CHANNELS=  # e.g. bot-spam,spam,off-topic

# channel(s) where /report submissions are posted
REPORT_CHANNELS=  # e.g. reports,mod-reports

MOD_LOG_CHANNELS= # channel(s) where warn/jail mod actions are logged, e.g. mod-log

# Appearance (Optional)
BOT_ICON=  # e.g. https://your-domain.com/bot-icon.png

# =============================================================================
# QUICK SETUP GUIDE
# =============================================================================
# 1. Fill in TOKEN and database credentials above
# 2. Create roles/channels in Discord that match the names you specify
# 3. Add role/channel names to the variables above (comma separated, no spaces around commas)
# 4. Set boolean values to true/false as needed
# 5. Leave any optional variable empty to disable that feature

# Set to false to stop background workers (the member update queue).
# Leave unset in normal use - disabling it means member display names, avatars
# and roles are never written.
BACKGROUND_WORKERS_ENABLED=

# How often buffered presence changes are written, in milliseconds.
# Defaults to 1800000 (30 minutes). A serverless Postgres is billed for the
# time its compute is awake, and every flush keeps it awake for the five
# minutes it takes to suspend again, so a shorter interval costs quota fast.
# Set to 0 to stop storing presence entirely - nothing reads those columns in
# real time, and it is the cheapest quota saving available.
PRESENCE_FLUSH_INTERVAL_MS=

# Channel for detail logs (nickname changes, message edits/deletions).
# Defaults to JOIN_EVENT_CHANNELS when unset.
SERVER_LOG_CHANNELS=

# Channels never logged: staff rooms, and information channels where edits are
# routine. Accepts a channel name or a CATEGORY name - naming the category
# excludes everything inside it, including channels added later.
# Deleted messages from these channels are not stored either, so they cannot be
# recovered via /log-deleted-messages-history.
LOG_EXEMPT_CHANNELS=

# Channels a jail leaves alone for established members. Jailing otherwise
# deletes the member's last 14 days of messages in every channel. Accepts a
# channel name or a CATEGORY name, same as LOG_EXEMPT_CHANNELS.
# Only applies to members holding a DELETE_EXEMPT_ROLES role - a raider with
# nothing but the base member role still gets the lot removed.
# e.g. Casual,Knowledge Base,Information
DELETE_EXEMPT_CHANNELS=

# Roles that earn the protection above. Empty = it applies to everyone.
# Staff are not covered automatically - list them here if you want a moderator
# jailed by a colleague to keep their history, since a manual jail is
# deliberately exempt from the STAFF_ROLES auto-punishment guard.
# e.g. OG,Admin,Moderator
DELETE_EXEMPT_ROLES=

# Channels a jail never sweeps, whoever is jailed and whatever roles they hold.
# For channels that are not really the member's posts - the welcome channel is
# Discord's own join notices, authored by the joining member.
# e.g. welcome
DELETE_NEVER_CHANNELS=

# Forum boards whose posts the AI checks against a template, deleting posts that
# do not match and jailing after 3 strikes. Empty = off.
# Valid values: job-board, dev-board, showcase
TEMPLATE_VALIDATION_BOARDS=
